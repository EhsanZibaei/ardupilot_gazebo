<?xml version="1.0"?>
<robot name="iris_with_gimbal">
  
  <!-- ========== IRIS QUADCOPTER BASE ========== -->
  
  <link name="base_link">
 
    <visual name="base_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://ardupilot_gazebo/models/iris_with_standoffs/meshes/iris.dae"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.05 0.05 0.05 1"/>
      </material>
    </visual>
    
    <visual name="front_left_leg">
      <origin xyz="0.123 0.22 -0.11" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.005" length="0.17"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.05 0.05 0.05 1"/>
      </material>
    </visual>
    
    <visual name="front_right_leg">
      <origin xyz="0.123 -0.22 -0.11" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.005" length="0.17"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.05 0.05 0.05 1"/>
      </material>
    </visual>
    
    <visual name="rear_left_leg">
      <origin xyz="-0.140 0.21 -0.11" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.005" length="0.17"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.05 0.05 0.05 1"/>
      </material>
    </visual>
    
    <visual name="rear_right_leg">
      <origin xyz="-0.140 -0.21 -0.11" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.005" length="0.17"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.05 0.05 0.05 1"/>
      </material>
    </visual>
  </link>

  <!-- IMU Link -->
  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
    </inertial>
  </link>
  
  <joint name="imu_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>

    <!-- ========== GIMBAL ATTACHMENT ========== -->
  
  <joint name="gimbal_joint" type="fixed">
    <origin xyz="0 -0.01 -0.124923" rpy="1.5707963 0 1.5707963"/>
    <parent link="base_link"/>
    <child link="gimbal_link"/>
  </joint>

  <!-- ========== GIMBAL LINKS ========== -->
  
  <link name="gimbal_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://ardupilot_gazebo/models/gimbal_small_3d/meshes/base_plate.dae"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    
    <collision>
      <origin xyz="0.01 0.075 -0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.05 0.15"/>
      </geometry>
    </collision>
  </link>

  <link name="yaw_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
    
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://ardupilot_gazebo/models/gimbal_small_3d/meshes/yaw_arm.dae"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://ardupilot_gazebo/models/gimbal_small_3d/meshes/yaw_arm.dae"/>
      </geometry>
    </collision>
  </link>

  <joint name="yaw_joint" type="revolute">
    <origin xyz="0.0105 0.065 -0.002" rpy="0 0 0"/>
    <parent link="gimbal_link"/>
    <child link="yaw_link"/>
    <axis xyz="0 1 0"/>
    <limit lower="-3.1415926" upper="3.1415926" effort="1.0" velocity="1.0"/>
    <dynamics damping="0.01"/>
  </joint>

  <link name="roll_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
    
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://ardupilot_gazebo/models/gimbal_small_3d/meshes/roll_arm.dae"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.1 0.1 0.1 1"/>
      </material>
    </visual>
    
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://ardupilot_gazebo/models/gimbal_small_3d/meshes/roll_arm.dae"/>
      </geometry>
    </collision>
  </link>

  <joint name="roll_joint" type="revolute">
    <origin xyz="0.0099 0.002 -0.05" rpy="0 0 0"/>
    <parent link="yaw_link"/>
    <child link="roll_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1415926" upper="3.1415926" effort="1.0" velocity="1.0"/>
    <dynamics damping="0.01"/>
  </joint>

  <link name="pitch_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
    
    <visual name="enclosure">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://ardupilot_gazebo/models/gimbal_small_3d/meshes/camera_enclosure.dae"/>
      </geometry>
      <material name="light_grey">
        <color rgba="0.4 0.4 0.4 1"/>
      </material>
    </visual>
    
    <visual name="camera">
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.050"/>
      </geometry>
      <material name="light_grey">
        <color rgba="0.4 0.4 0.4 1"/>
      </material>
    </visual>
    
    <collision name="enclosure">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://ardupilot_gazebo/models/gimbal_small_3d/meshes/camera_enclosure.dae"/>
      </geometry>
    </collision>
    
    <collision name="camera">
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.050"/>
      </geometry>
    </collision>
  </link>

  <joint name="pitch_joint" type="revolute">
    <origin xyz="0.045 0.0021 0.0199" rpy="0 0 0"/>
    <parent link="roll_link"/>
    <child link="pitch_link"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.1415926" upper="3.1415926" effort="1.0" velocity="1.0"/>
    <dynamics damping="0.01"/>
  </joint>

  <!-- Camera optical frame (for sensor data) -->
  <link name="camera_link"/>
  
  <joint name="camera_joint" type="fixed">
    <origin xyz="0 0 0.04" rpy="-1.57 -1.57 0"/>
    <parent link="pitch_link"/>
    <child link="camera_link"/>
  </joint>

  <link name="yolo_link"></link>
  <joint name="yolo_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.57 0 -1.57"/>
    <parent link="camera_link"/>
    <child link="yolo_link"/>
  </joint>
</robot>