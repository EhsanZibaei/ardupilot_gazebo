<?xml version="1.0"?>
<robot name="gimbal_small_3d">

  <!-- Gimbal Base Link -->
  <link name="gimbal_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" 
               iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://ardupilot_gazebo/models/gimbal_small_3d/meshes/base_plate.dae"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.01 0.075 -0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.05 0.15"/>
      </geometry>
    </collision>
  </link>

  <!-- Yaw Link -->
  <link name="yaw_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" 
               iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://ardupilot_gazebo/models/gimbal_small_3d/meshes/yaw_arm.dae"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://ardupilot_gazebo/models/gimbal_small_3d/meshes/yaw_arm.dae"/>
      </geometry>
    </collision>
  </link>

  <!-- Yaw Joint -->
  <joint name="yaw_joint" type="revolute">
    <parent link="gimbal_link"/>
    <child link="yaw_link"/>
    <origin xyz="0.0105 0.065 -0.002" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.01"/>
    <limit lower="-3.1415926" upper="3.1415926" effort="100" velocity="1.0"/>
  </joint>

  <!-- Roll Link -->
  <link name="roll_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" 
               iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://ardupilot_gazebo/models/gimbal_small_3d/meshes/roll_arm.dae"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://ardupilot_gazebo/models/gimbal_small_3d/meshes/roll_arm.dae"/>
      </geometry>
    </collision>
  </link>

  <!-- Roll Joint -->
  <joint name="roll_joint" type="revolute">
    <parent link="yaw_link"/>
    <child link="roll_link"/>
    <origin xyz="0.0099 0.002 -0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <dynamics damping="0.01"/>
    <limit lower="-3.1415926" upper="3.1415926" effort="100" velocity="1.0"/>
  </joint>

  <!-- Pitch Link -->
  <link name="pitch_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" 
               iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://ardupilot_gazebo/models/gimbal_small_3d/meshes/camera_enclosure.dae"/>
      </geometry>
      <material name="light_grey">
        <color rgba="0.4 0.4 0.4 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://ardupilot_gazebo/models/gimbal_small_3d/meshes/camera_enclosure.dae"/>
      </geometry>
    </collision>
  </link>

  <!-- Pitch Joint -->
  <joint name="pitch_joint" type="revolute">
    <parent link="roll_link"/>
    <child link="pitch_link"/>
    <origin xyz="0.045 0.0021 0.0199" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <dynamics damping="0.01"/>
    <limit lower="-3.1415926" upper="3.1415926" effort="100" velocity="1.0"/>
  </joint>

  <!-- Camera Optical Frame Link -->
  <link name="camera_optical_frame">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" 
               iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.050"/>
      </geometry>
      <material name="light_grey">
        <color rgba="0.4 0.4 0.4 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.050"/>
      </geometry>
    </collision>
  </link>

  <!-- Camera Optical Joint - CRITICAL: This includes the link pose from SDF -->
  <joint name="camera_optical_joint" type="fixed">
    <parent link="pitch_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0.02" rpy="-1.57 -1.57 0"/>
  </joint>

  <!-- Gazebo-specific materials -->
  <gazebo reference="gimbal_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <gazebo reference="yaw_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <gazebo reference="roll_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <gazebo reference="pitch_link">
    <material>Gazebo/Grey</material>
  </gazebo>

  <gazebo reference="camera_optical_frame">
    <material>Gazebo/Grey</material>
  </gazebo>

  <!-- Gazebo sensor configuration -->
  <gazebo reference="camera_optical_frame">
    <sensor name="rgbd_camera" type="rgbd_camera">
      <pose>0 0 0 0 0 0</pose>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
        </image>
        <clip>
          <near>0.1</near>
          <far>100</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <update_rate>10</update_rate>
      <visualize>1</visualize>

      <plugin filename="libCameraZoomPlugin.so" name="CameraZoomPlugin">
        <max_zoom>125.0</max_zoom>
        <slew_rate>0.42514285714</slew_rate>
      </plugin>
      
      <plugin name="GstCameraPlugin" filename="libGstCameraPlugin.so">
        <udp_host>127.0.0.1</udp_host>
        <udp_port>5600</udp_port>
        <use_basic_pipeline>true</use_basic_pipeline>
        <use_cuda>false</use_cuda>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Gazebo system plugins -->
  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
    </plugin>

    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>gimbal_link</robot_base_frame>
      <dimensions>3</dimensions>
    </plugin>
  </gazebo>

</robot>